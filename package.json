{
  "name": "@idpxyz/ui",
  "private": true,
  "version": "0.1.0",
  "description": "IDP Design System — shared UI tokens, primitives, patterns, workspace components, and icons for the IDP product family.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/idp-xyz/ui.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm -r --filter \"./packages/*\" build",
    "clean": "pnpm -r exec rm -rf dist",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "pack:all": "pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../dist-tarballs",
    "publish:all": "pnpm -r --filter \"./packages/*\" publish --access restricted --no-git-checks"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "~5.6.2"
  }
}
